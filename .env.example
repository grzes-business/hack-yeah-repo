# Copy to .env.local and fill in. Public Supabase values and server-only variable names are documented below. Never commit real keys.
# Project URL: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: Supabase dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only: never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional voice model override; requires account access to the chosen Realtime model.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Server-only structured extraction model (Stage 4).
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini

# Stage 6 trusted derived-data writer. Secret/service-role key; server only.
# Never use NEXT_PUBLIC_, commit a real key, or expose it to a browser/model.
SUPABASE_SERVICE_ROLE_KEY=
