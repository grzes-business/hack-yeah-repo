# Copy to .env.local and fill in. Only public values belong here; never add a Supabase secret or service role key.
# Project URL: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: Supabase dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
