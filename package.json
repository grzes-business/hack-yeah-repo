{
  "name": "hack-yeah-repo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.contracts.json && node --test .contract-tests/domain/*.test.js .contract-tests/health/*.test.js .contract-tests/db/*.test.js .contract-tests/demo/*.test.js .contract-tests/conversation/*.test.js .contract-tests/checkin/*.test.js .contract-tests/analytics/*.test.js .contract-tests/investigation/*.test.js .contract-tests/questions/*.test.js",
    "verify:hosted": "pnpm test && node --env-file=.env.local scripts/verify-hosted.mjs",
    "verify:voice": "pnpm test && node --env-file=.env.local scripts/verify-voice.mjs",
    "verify:investigation": "pnpm test && node --env-file=.env.local scripts/verify-investigation.mjs",
    "verify:questions": "pnpm test && node --env-file=.env.local scripts/verify-questions.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5"
  }
}
